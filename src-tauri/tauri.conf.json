{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Calculadora-Rok",
  "version": "0.1.0",
  "identifier": "com.tauri.dev",
  "build": {
    "frontendDist": "../www"
  },
  "app": {
    "windows": [
      {
     "title": "Calculadora Rok - Sistema Modular",
        "width": 460,
        "height": 680,
        "minWidth": 420,
        "minHeight": 620,
        "maxWidth": 600,
        "maxHeight": 850,
        "resizable": true,
        "center": true,
        "backgroundColor": "#05070c"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
